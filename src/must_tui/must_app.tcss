LoadingScreen {
    align: center middle;
}

#loading-dialog {
    border: thick $primary 50%;
    background: $boost;
    width: 50%;
    height: 11;
    padding: 1 2;
    align: center middle;
    content-align: center middle;
}

#loading-title {
    text-style: bold;
    content-align: center middle;
    width: 1fr;
    margin-bottom: 1;
}

#loading-status {
    content-align: center middle;
    width: 1fr;
    margin-bottom: 1;
}

#loading-subtitle {
    color: $text-muted;
    content-align: center middle;
    width: 1fr;
}

OptionList {
/*  border: solid green; */
    width: 20%;
    height: 1fr;
}

#input-container {
/*    border: solid red; */
    height: 3;
}

#main-container {
/*  border: solid red; */
    width: auto;
    height: 1fr;
}

#info-container {
/*    border: solid red; */
    width: 1fr;
    height: 1fr;
}

#plot-controls {
/*    border: solid red; */
    height: 3;
}

#status-bar {
    height: 1;
    color: $text-muted;
    padding: 0 1;
}

/* Textual's default Button style reverses the label text on focus (which a click leaves behind); show the
   already-present subtle background tint instead of reversing the text. */
#plot-controls Button:focus {
    text-style: bold;
}

#bt-plot-clear {
/*    border: solid red; */
}

/* "z" toggles this: hide everything except the plot and its controls, which then fill the screen. */
MainScreen.-plot-maximized Header,
MainScreen.-plot-maximized Footer,
MainScreen.-plot-maximized #input-container,
MainScreen.-plot-maximized OptionList,
MainScreen.-plot-maximized #info-container,
MainScreen.-plot-maximized #status-bar {
    display: none;
}

DataTable {
/*  border: round red; */
    width: 100%;
    height: auto;
}

ParameterInfo {
/*  border: heavy white; */
    height: 1fr;
    width: 50%;
}

ParameterMetadata {
/*  border: heavy white; */
    height: 1fr;
    width: 50%;
}

PlotWidget {
/*    border: solid blue; */
    height: 1fr;
}

#input-search {
/*    border: solid white; */
    height: 3;
    width: 1fr;
}

#regex-checkbox {
/*    border: solid white; */
    width: 15;
    height: 3;
}

ErrorDialog {
    align: center middle;
}

ErrorDialog > Vertical {
    border: thick $primary 50%;
    width: 50%;
    height: 16;
    background: $boost;
    Label {
        text-style: bold;
        margin: 2 4;
    }
    Button {
        margin: 0 2;
    }
    Horizontal {
        width: 100%;
        align: center top;
        #btn-dialog-yes {
            margin-right: 2;
        }
    }
}


WarningDialog {
    align: center middle;
}

WarningDialog > Vertical {
    border: thick $primary 50%;
    width: 50%;
    height: 16;
    background: $boost;
    Label {
        text-style: bold;
        margin: 2 4;
    }
    Button {
        margin: 0 2;
    }
    Horizontal {
        width: 100%;
        align: center top;
        #btn-dialog-yes {
            margin-right: 2;
        }
    }
}

HelpDialog {
    align: center middle;
}

HelpDialog > Vertical {
    border: thick $primary 50%;
    width: 80%;
    height: 80%;
    background: $boost;
    padding: 1 2;

    VerticalScroll {
        height: 1fr;
    }

    #btn-dialog-close {
        width: 100%;
        margin-top: 1;
    }
}
